{
  "name": "ultimate-research",
  "version": "2.2.0",
  "description": "The Ultimate Research Engine: DRACO Deep Research Benchmark #1 (Score 77.7), Hyperresearch 16-step Tier-Adaptive Pipeline, Persistent Zettelkasten Vault (research/notes/), Open-Access Recovery, Unified Perplexity Prompting, Super Deslop Search, ARS Epistemic Verification, Elephant-Goldfish Adversarial Mutation Gates, and Google Research Harness².",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-tools.d.ts",
      "import": "./dist/mcp-tools.js"
    }
  },
  "bin": {
    "ultimate-research": "./dist/cli.js",
    "deslop": "./dist/cli.js",
    "deslop-search": "./dist/cli.js",
    "ultimate-vault": "./scripts/vault.mjs"
  },
  "files": [
    "dist",
    "data",
    "references",
    "schemas",
    "scripts",
    "templates",
    "workflows",
    "SKILL.md",
    "skill.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python -m unittest discover -s tests/py -p \"test_*.py\" -v",
    "test:negative": "node --test tests/negative-scenarios.test.mjs",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "env:check": "node scripts/env-check.mjs",
    "verify": "npm run typecheck && npm run build && npm run test && npm run test:py && node scripts/validate-schemas.mjs && node --test tests/negative-scenarios.test.mjs",
    "deslop": "node ./dist/cli.js",
    "research": "node ./dist/cli.js",
    "vault": "node scripts/vault.mjs",
    "citecheck": "node scripts/vault.mjs citecheck"
  },
  "keywords": [
    "ultimate-research",
    "deep-research",
    "perplexity-prompting",
    "elephant-goldfish",
    "google-harness",
    "claim-mutation-testing",
    "anti-slop",
    "deslop-search",
    "ars-verification",
    "epistemic-audit",
    "split-horizon",
    "ai-agent-skill",
    "mcp",
    "fact-checking",
    "citation-verification",
    "cli",
    "hyperresearch",
    "draco-benchmark",
    "vault",
    "zettelkasten"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Antigravity Engineering / Ultimate Research Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
