{
  "name": "ultimate-research",
  "version": "2.0.0",
  "description": "The Ultimate Research Engine: Fusion of Perplexity Prompting, Deep Multi-Wave Research, Super Deslop Search (Anti-Slop & Split-Horizon), ARS Epistemic Citation Verification, Elephant-Goldfish Adversarial Auditing, and Google Research Harness² Recursive Optimization.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-tools.d.ts",
      "import": "./dist/mcp-tools.js"
    }
  },
  "bin": {
    "ultimate-research": "./dist/cli.js",
    "deslop": "./dist/cli.js",
    "deslop-search": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "SKILL.md",
    "skill.json",
    "README.md",
    "LICENSE",
    "*.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python -m unittest discover -s tests/py -p \"test_*.py\" -v",
    "verify": "npm run typecheck && npm run build && npm run test && npm run test:py",
    "deslop": "node ./dist/cli.js",
    "research": "node ./dist/cli.js"
  },
  "keywords": [
    "ultimate-research",
    "deep-research",
    "perplexity-prompting",
    "elephant-goldfish",
    "google-harness",
    "anti-slop",
    "deslop-search",
    "ars-verification",
    "epistemic-audit",
    "split-horizon",
    "ai-agent-skill",
    "mcp",
    "fact-checking",
    "citation-verification",
    "cli"
  ],
  "author": "Antigravity Engineering / Ultimate Research Contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
