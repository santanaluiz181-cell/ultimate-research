{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.local/schemas/ultimate-research/research-plan.schema.json",
  "title": "UltimateResearchPlan",
  "description": "Structured contract for Phase 1 (Intent Analysis), Phase 2 (Research Planning), and Phase 3 (Query Engineering).",
  "type": "object",
  "required": [
    "plan_id",
    "created_at",
    "mode",
    "intent",
    "temporal_strategy",
    "hypotheses",
    "sub_questions",
    "inclusion_criteria",
    "exclusion_criteria",
    "bias_risks",
    "expected_gaps",
    "execution_topology"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^UR-PLAN-[A-Z0-9-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "QUICK_RESEARCH",
        "DEEP_RESEARCH",
        "ACADEMIC_RESEARCH",
        "JOURNALISTIC_INVESTIGATION",
        "TECHNICAL_RESEARCH",
        "MARKET_RESEARCH",
        "LEGAL_RESEARCH",
        "FACT_CHECKING"
      ]
    },
    "workflow_variant": {
      "type": "string",
      "enum": [
        "quick-research",
        "deep-research",
        "academic-research",
        "journalistic-investigation",
        "technical-research",
        "market-research",
        "legal-research",
        "fact-checking",
        "competitive-intelligence"
      ]
    },
    "intent": {
      "type": "object",
      "required": [
        "objective",
        "central_question",
        "scope",
        "audience",
        "geographic_scope",
        "temporal_scope",
        "depth",
        "required_evidence_types"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 5 },
        "central_question": { "type": "string", "minLength": 10 },
        "scope": { "type": "string", "enum": ["narrow_point", "focused_analysis", "broad_survey", "exhaustive_audit"] },
        "audience": { "type": "string", "minLength": 2 },
        "geographic_scope": { "type": "string", "minLength": 2 },
        "temporal_scope": { "type": "string", "minLength": 2 },
        "depth": { "type": "string", "enum": ["single_pass", "multi_query", "multi_wave"] },
        "required_evidence_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "primary_document",
              "official_registry",
              "legislation",
              "jurisprudence",
              "peer_reviewed_study",
              "official_documentation",
              "source_code_or_rfc",
              "editorial_journalism",
              "market_filing",
              "technical_community"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "temporal_strategy": {
      "type": "object",
      "required": ["lanes_enabled", "cutoff_applied", "cutoff_justification"],
      "properties": {
        "lanes_enabled": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["LANE_A_HISTORICAL", "LANE_B_CONTEMPORARY", "LANE_C_OFFICIAL_VALIDATION"]
          }
        },
        "cutoff_applied": {
          "type": "boolean"
        },
        "cutoff_date": {
          "type": "string",
          "description": "Explicit YYYY or YYYY-MM-DD cutoff when temporal splitting is warranted."
        },
        "cutoff_justification": {
          "type": "string",
          "minLength": 10,
          "description": "Mandatory rationale explaining why this cutoff date (or no cutoff) fits the problem."
        }
      },
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "array",
      "items": { "type": "string", "minLength": 5 }
    },
    "sub_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "priority_tier", "queries"],
        "properties": {
          "id": { "type": "string", "pattern": "^SQ-[0-9]{2}$" },
          "question": { "type": "string", "minLength": 10 },
          "priority_tier": { "type": "string", "enum": ["TIER_1", "TIER_2", "TIER_3", "TIER_4"] },
          "perspective": { "type": "string", "enum": ["baseline", "primary_official", "academic", "adversarial_dissent", "community_edge_cases"] },
          "queries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["query", "channel"],
              "properties": {
                "query": { "type": "string", "minLength": 3 },
                "channel": { "type": "string" },
                "dork_compiled": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "priority_sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inclusion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "exclusion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "bias_risks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "expected_gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "execution_topology": {
      "type": "object",
      "required": ["use_parallel_agents", "max_agents_per_wave", "max_waves", "use_ars_verifier", "use_deslop_classifier"],
      "properties": {
        "use_parallel_agents": { "type": "boolean" },
        "max_agents_per_wave": { "type": "integer", "minimum": 0, "maximum": 5 },
        "max_waves": { "type": "integer", "minimum": 1, "maximum": 6 },
        "use_ars_verifier": { "type": "boolean" },
        "use_deslop_classifier": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
